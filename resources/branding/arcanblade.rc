// Dark Explorer/desktop, window and tray artwork; internal surfaces use the white mark.
#include <winver.h>

IDI_ARCANBLADE ICON "arcanblade.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ARCANBLADE_VERSION_MAJOR,ARCANBLADE_VERSION_MINOR,ARCANBLADE_VERSION_PATCH,0
 PRODUCTVERSION ARCANBLADE_VERSION_MAJOR,ARCANBLADE_VERSION_MINOR,ARCANBLADE_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Arcanblade ASMR Player"
            VALUE "FileVersion", ARCANBLADE_VERSION
            VALUE "InternalName", "Arcanblade"
            VALUE "OriginalFilename", "Arcanblade.exe"
            VALUE "ProductName", "Arcanblade"
            VALUE "ProductVersion", ARCANBLADE_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
